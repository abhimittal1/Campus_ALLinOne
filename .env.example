# Copy this file to .env and fill in the values.
# Run: copy .env.example .env   (Windows) | cp .env.example .env   (Linux/macOS)

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite — no server needed; file is auto-created on first run
DATABASE_URL=sqlite:///./attendance.db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Camera ────────────────────────────────────────────────────────────────────
# IP Webcam app URL (Android) — e.g. http://192.168.x.x:8080/video
CAMERA_URL=http://192.168.x.x:8080/video

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Default Admin (development only) ─────────────────────────────────────────
# Auto-seeded on first run. Change before deploying to production.
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin12345

# ─── RAG / Chatbot ─────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# ChromaDB path (default is auto-set from project root — override only if needed)
# CHROMA_DB_PATH=data/vector_store/chroma_db
